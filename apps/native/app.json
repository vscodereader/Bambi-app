{
  "expo": {
    "scheme": "bambi-app",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "bambi-app",
    "slug": "bambi-app",
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 등록하려면 사진 접근이 필요해요.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
