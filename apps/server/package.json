    "@fastify/cors": "^11.0.1",
    "@fastify/schedule": "^6.0.0",
    "@google-cloud/storage": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:",
    "fastify": "^5.3.3",
    "fastify-plugin": "^6.0.0",
    "socket.io": "^4.8.3",
