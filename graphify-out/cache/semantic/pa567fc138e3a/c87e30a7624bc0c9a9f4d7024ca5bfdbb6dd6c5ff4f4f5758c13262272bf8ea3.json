{"nodes": [{"id": "docs_superpowers_plans_2026_08_05_main_popup_management_main_popup_management_plan", "label": "Main Page Moderator Popup Management Design Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-08-05-main-popup-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_05_main_popup_management_moderator_popup_management", "label": "Moderator Popup Management", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-08-05-main-popup-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_05_main_popup_management_responsive_popup_delivery", "label": "Responsive Popup Delivery", "file_type": "rationale", "rationale": "Desktop uses simultaneous nonmodal popup layers so exposed page areas remain interactive, while mobile uses a blocking single-popup queue because the limited viewport cannot safely present the same interaction model.", "source_file": "docs/superpowers/plans/2026-08-05-main-popup-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_05_main_popup_management_revision_aware_24_hour_suppression", "label": "Revision-Aware 24-Hour Popup Suppression", "file_type": "rationale", "rationale": "Per-popup localStorage expiry preserves an exact browser-local 24-hour dismissal, while a changed server revision invalidates stale suppression so edited content is shown immediately.", "source_file": "docs/superpowers/plans/2026-08-05-main-popup-management.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_08_05_main_popup_management_popup_content_types", "label": "Image and Rich-Text Popup Content Types", "file_type": "concept",